{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "devcontainer",
    "github-actions"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📦 Renovate Dependency Dashboard",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "esphome-version:\\s*\\n(?:[ \\t]*- stable\\n)?(?<depValues>([ \\t]*- (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n)+)"
      ],
      "depNameTemplate": "ghcr.io/esphome/esphome",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "esphome-version:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "esphome/esphome",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "esphome-version:\\s+(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/esphome/esphome",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/esphome/esphome"
      ],
      "matchDatasources": [
        "docker"
      ],
      "groupName": "ESPHome Versionsupdate",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "esphome/workflows 2026.x pulls in build-action v8, which requires ESPHome >= 2026.7.0. Lift this cap only together with the esphome-version bump in publish-firmware.yml.",
      "matchDepNames": [
        "esphome/workflows"
      ],
      "allowedVersions": "<2026.0.0"
    },
    {
      "description": "build-action v8 requires ESPHome >= 2026.7.0; ci.yml still builds 2025.7.2 / 2025.11.0. Lift this cap only together with the esphome-version matrix bump in ci.yml.",
      "matchDepNames": [
        "esphome/build-action"
      ],
      "allowedVersions": "<8.0.0"
    }
  ]
}
